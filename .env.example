# ---------- Required ----------
MONGO_URI=mongodb://127.0.0.1:27017/pixoxiq
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Server ----------
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Extra allowed browser origins, comma separated (the deployed admin panel is always allowed)
CLIENT_URLS=http://localhost:5173,http://localhost:8080
# Public URL of this API (used to build links to uploaded files)
API_PUBLIC_URL=http://localhost:5000

# ---------- First superadmin (npm run seed) ----------
SEED_ADMIN_NAME=Pixoxiq Admin
SEED_ADMIN_EMAIL=admin@pixoxiq.com
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- AI assistant ----------
# There is NO AI provider, model or API key here on purpose: a superadmin chooses them in
# Admin panel -> AI Assistant -> AI Configuration, and keys are stored encrypted in MongoDB.
#
# Encryption key for stored provider API keys: 32 random bytes as 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and stable: if it changes, saved API keys must be re-entered.
AI_ENCRYPTION_KEY=

# Optional tuning (defaults shown)
# CHAT_RATE_LIMIT_PER_MINUTE=12
# CHAT_SESSIONS_PER_HOUR=30
# AI_PROVIDER_TIMEOUT_MS=90000
# KNOWLEDGE_MAX_FILE_MB=10
