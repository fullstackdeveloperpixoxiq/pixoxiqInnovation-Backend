# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/pixoxiq

# JWT - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontends (admin panel + public website)
CLIENT_URLS=http://localhost:5173,http://localhost:8080

# Public base URL of this API (used to build uploaded file URLs)
API_PUBLIC_URL=http://localhost:5000

# First admin account created by `npm run seed`
SEED_ADMIN_NAME=Pixoxiq Admin
SEED_ADMIN_EMAIL=admin@pixoxiq.com
SEED_ADMIN_PASSWORD=Admin@12345
