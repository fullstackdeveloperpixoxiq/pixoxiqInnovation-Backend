# ---------- Required ----------
MONGO_URI=mongodb://127.0.0.1:27017/pixoxiq
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Server ----------
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Extra allowed browser origins, comma separated (the deployed admin panel is always allowed)
CLIENT_URLS=http://localhost:5173,http://localhost:8080
# Public URL of this API (used to build links to uploaded files)
API_PUBLIC_URL=http://localhost:5000

# ---------- First superadmin (npm run seed) ----------
SEED_ADMIN_NAME=Pixoxiq Admin
SEED_ADMIN_EMAIL=admin@pixoxiq.com
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- AI assistant ----------
# There is NO AI provider, model or API key here on purpose: a superadmin chooses them in
# Admin panel -> AI Assistant -> AI Configuration, and keys are stored encrypted in MongoDB.
#
# Encryption key for stored provider API keys: 32 random bytes as 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and stable: if it changes, saved API keys must be re-entered.
AI_ENCRYPTION_KEY=

# Optional tuning (defaults shown)
# CHAT_RATE_LIMIT_PER_MINUTE=12
# CHAT_IDENTITY_RATE_LIMIT_PER_MINUTE=8
# Minutes until an assistant email verification code expires (2-60)
# CHAT_OTP_TTL_MINUTES=10
# CHAT_OTP_REQUESTS_PER_15_MIN=15
# Daily question quotas (visitors 10, logged-in users 100, reset at midnight IST) are set in
# Admin panel -> AI Assistant -> Chatbot Settings, not here.
# CHAT_SESSIONS_PER_HOUR=30
# AI_PROVIDER_TIMEOUT_MS=90000
# KNOWLEDGE_MAX_FILE_MB=10

# ---------- Announcements & Newsletter ----------
# Public website URL (newsletter verify / unsubscribe links point here)
SITE_URL=https://www.pixoxiq.com
# Email service for newsletter verification + campaigns: "resend" or "brevo".
# Set the matching API key. Without one, subscribers are confirmed without a verification
# email and newsletters cannot be sent.
EMAIL_PROVIDER=
RESEND_API_KEY=
BREVO_API_KEY=
# Sender address on a domain verified with the provider
EMAIL_FROM=newsletter@pixoxiq.com
EMAIL_FROM_NAME=PIXOXIQ Innovations
# Aliases also accepted: BREVO_SENDER_EMAIL / BREVO_SENDER_NAME.
# Email is also used for account registration OTPs (required for sign-up).
